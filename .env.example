# Kopie als .env anlegen. Ohne Key läuft der Agent mit Regeln statt mit Jev (siehe README).
TYPESAFE_API_KEY=

# Integrationsschicht (python -m integrations ...). Alles optional: leer = lokal, unsigniert, nur für Tests.
# Sobald ein Wert gesetzt ist, wird die zugehörige Prüfung Pflicht (siehe docs/integrationen.md).

# signiert Custom-Calendar- und Contact-Lookup-Anfragen (x-telli-signature), Auth für die telli-API
TELLI_API_KEY=
# Agent, mit dem Leads angerufen werden (Schedule Call)
TELLI_AGENT_ID=
# Svix-Geheimnis des call_ended-Webhooks, Präfix whsec_
TELLI_WEBHOOK_SECRET=
# Bearer-Token, das telli als "Secret"-Header an die Custom Tools schickt
TOOL_SECRET=
# Ziel für ausgehende Ereignisse (Ticketsystem, Automationsplattform) und das Geheimnis zum Signieren
KUNDE_WEBHOOK_URL=
KUNDE_WEBHOOK_SECRET=
# Private-App-Token; gesetzt = Spiegelung ins HubSpot-CRM
HUBSPOT_TOKEN=
ZEITZONE=Europe/Berlin
TOOL_LATENZBUDGET_MS=800
# prod: der Server startet nur mit vollständigen Geheimnissen
UMGEBUNG=dev
# Takt des Hintergrundplaners (Outbox, Spiegelung) und des Lead-Push in Sekunden
TAKT_S=15
PUSH_TAKT_S=60
# Abgleich mit List Calls gegen Webhook-Lücken (Sekunden)
ABGLEICH_TAKT_S=1800
# Use Case (integrations/usecases): pv_outbound | telko_inbound; Regeln des Use Case lassen sich überschreiben
USECASE=pv_outbound
VERIFIZIERUNG_PFLICHT=
MINDESTVORLAUF_H=
# Salesforce statt HubSpot als Spiegel: Instance-URL plus Token, oder Client-Credentials (Connected App)
SALESFORCE_INSTANCE_URL=
SALESFORCE_TOKEN=
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# Kalenderdienst hinter den Slots: leer = Slot-Tabelle, calcom = Cal.com API v2 (Event-Typ mit optionaler E-Mail)
KALENDER=
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_URL=https://api.cal.com
KALENDER_TAKT_S=300
KALENDER_TAGE=14
# Aufbewahrung in Tagen (0 = nie); ohne Angabe gelten die Vorgaben aus integrations/aufbewahrung.py
AUFBEWAHRUNG_TRANSKRIPTE_TAGE=30
AUFBEWAHRUNG_TICKETS_TAGE=90
AUFBEWAHRUNG_ZUSTELLUNGEN_TAGE=30
AUFBEWAHRUNG_PROTOKOLL_TAGE=365
AUFBEWAHRUNG_TAKT_S=86400
# geheimer Schlüssel für das Pseudonym der Nummer im Löschprotokoll (HMAC); leer = einfacher Hash
DATENSCHUTZ_PEPPER=

# Kanal-Fallback (integrations/nachfass.py): nie erreichte Leads mit Einwilligung bekommen eine Nachricht
# mit Buchungslink, zugestellt über KUNDE_WEBHOOK_URL (Ereignis nachricht.nachfassen). Leer = aus.
NACHFASS_KANAL=
NACHFASS_LINK=
NACHFASS_KUNDE=
