# Kopie als .env anlegen. Ohne Key läuft der Agent mit Regeln statt mit Jev (siehe README).
TYPESAFE_API_KEY=

# Integrationsschicht (python -m integrations ...). Alles optional: leer = lokal, unsigniert, nur für Tests.
# Sobald ein Wert gesetzt ist, wird die zugehörige Prüfung Pflicht (siehe docs/integrationen.md).

# signiert Custom-Calendar- und Contact-Lookup-Anfragen (x-telli-signature), Auth für die telli-API
TELLI_API_KEY=
# Agent, mit dem Leads angerufen werden (Schedule Call)
TELLI_AGENT_ID=
# Svix-Geheimnis des call_ended-Webhooks, Präfix whsec_
TELLI_WEBHOOK_SECRET=
# Bearer-Token, das telli als "Secret"-Header an die Custom Tools schickt
TOOL_SECRET=
# Ziel für ausgehende Ereignisse (Ticketsystem, Automationsplattform) und das Geheimnis zum Signieren
KUNDE_WEBHOOK_URL=
KUNDE_WEBHOOK_SECRET=
# Private-App-Token; gesetzt = Spiegelung ins HubSpot-CRM
HUBSPOT_TOKEN=
ZEITZONE=Europe/Berlin
TOOL_LATENZBUDGET_MS=800
# prod: der Server startet nur mit vollständigen Geheimnissen
UMGEBUNG=dev
# Takt des Hintergrundplaners (Outbox, Spiegelung) und des Lead-Push in Sekunden
TAKT_S=15
PUSH_TAKT_S=60
