# Kopieren nach .env und ausfüllen. .env niemals committen.
# Zufallswerte erzeugen: openssl rand -base64 32
POSTGRES_PASSWORD=bitte-aendern          # Eigentümerrolle shk, nur für Migrationen und Sicherung
SHK_APP_PASSWORD=bitte-aendern           # Rolle shk_app (Core, unterliegt Row-Level Security)
SHK_SYSTEM_PASSWORD=bitte-aendern        # Rolle shk_system (Worker, Seed, Mandantenverwaltung)
CORE_API_KEY=bitte-langen-zufallswert-setzen
# Verschlüsselung der Zugangsdaten zu Drittsystemen (Lexware, sevDesk, SMTP …): python -m core schluessel
INTEGRATIONS_KEY=

# Anmeldung (Profil auth): Keycloak. Lokal: OIDC_ISSUER=http://localhost:8180/realms/shk
OIDC_ISSUER=
KEYCLOAK_ADMIN_PASSWORD=bitte-aendern    # nur für den ersten Start; danach eigenen Admin anlegen
# Mandanten-ID für den Voice-Agenten (Ausgabe von POST /mandanten)
CORE_MANDANT=
BETRIEB_NAME=Musterbetrieb Haustechnik

# LiveKit (Profil voice): Schlüsselpaar frei wählen, identisch in deploy/livekit/sip.yaml eintragen
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Sprachdienste (Profil voice). Standard: Azure Speech in EU-Region, Claude über EU-Endpunkt bzw. Gateway
STT_ANBIETER=azure
TTS_ANBIETER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=germanywestcentral
TTS_STIMME=de-DE-KatjaNeural
# Eigene Stimme (STIMME.md): azure = Custom-Neural-Voice-Name plus AZURE_TTS_ENDPOINT_ID; elevenlabs/cartesia = voice id des Klons
AZURE_TTS_ENDPOINT_ID=
ELEVEN_API_KEY=
CARTESIA_API_KEY=
TTS_MODELL=
LLM_ANBIETER=anthropic
LLM_MODELL=claude-haiku-5-5
ANTHROPIC_API_KEY=
LLM_BASE_URL=

# Serverbetrieb (deploy/server/docker-compose.prod.yml, HOSTING.md)
SHK_DOMAIN=
ACME_EMAIL=
SHK_VERSION=
KEYCLOAK_DB_PASSWORD=
# Netze mit Zugriff auf die Keycloak-Admin-Konsole, z. B. Büro-IP/32 oder VPN-Netz
SHK_ADMIN_NETZE=127.0.0.1/32
# optional: Außer-Haus-Sicherung mit restic (z. B. sftp:u123456@u123456.your-storagebox.de:/shk)
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=

# Geokodierung der Kundenadressen für die Kundenkarte (Nominatim-kompatibel; öffentlicher OSM-Dienst: max. 1 Anfrage/s,
# Kontaktadresse Pflicht laut Nutzungsbedingungen). GEOCODER_AUS=1 schaltet den Aufruf ab (Koordinaten dann nur manuell).
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_EMAIL=
GEOCODER_AUS=

# Fahrzeiten und Touren: eigener OSRM-Server (Profil routing, deploy/osrm/vorbereiten.sh) oder leer für den Demo-Server
# (nur Tests, geringe Last). ROUTING_AUS=1 rechnet mit Luftlinie.
ROUTING_URL=http://osrm:5000
ROUTING_AUS=
# Kalender-Abo: Schlüssel für die Abo-Adressen (leer: INTEGRATIONS_KEY); Wechsel macht alle Adressen ungültig
KALENDER_SCHLUESSEL=
# Öffentliche Adresse der Plattform (für Kalender-Abo-Adressen und Push-Links; sonst Stammdatum basis_url)
BASIS_URL=https://shk.example.invalid
# ntfy (Profil push): öffentliche Adresse des eigenen ntfy-Servers
NTFY_BASE_URL=https://push.shk.example.invalid
